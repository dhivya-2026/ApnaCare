# ApnaCare Environment Variables Template

# Frontend Data Operations (Read-only / existing form submissions)
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx6gwpPkEgsO9y0lksDo2MS4LFXna4dnv20XkC4_KJd3voXqxTCyBuwPg4g_BM896YV/exec
VITE_GOOGLE_APPS_SCRIPT_SHEET2_URL=https://script.google.com/macros/s/AKfycbzXcPQUQh1SE6GW7KIQ6MS0tcXIVwRotu0M6uth-d1SvsGD89OytHgqkiYKersiyBwe/exec
VITE_GOOGLE_APPS_SCRIPT_ANALYTICS_URL=https://script.google.com/macros/s/AKfycbzXcPQUQh1SE6GW7KIQ6MS0tcXIVwRotu0M6uth-d1SvsGD89OytHgqkiYKersiyBwe/exec

# ==============================================================================
# VERCEL SERVER-SIDE REPORTING & CRON CONFIGURATION (DO NOT PREFIX WITH VITE_)
# Configure these in Vercel Project Settings > Environment Variables
# ==============================================================================

# Resend API Key for transactional report email delivery (starts with re_)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email address configured in Resend (e.g., reports@apnacare.in or onboarding@resend.dev)
REPORT_FROM_EMAIL=ApnaCare Reports <reports@apnacare.in>

# Comma-separated list of recipient email addresses for Daily, Weekly, and Monthly reports
REPORT_TO_EMAILS=operations@apnacare.in,divabhrati.ramco@gmail.com

# Secret key used to authorize Vercel Cron jobs and manual testing endpoints
# Generated random string (e.g., openssl rand -hex 32)
CRON_SECRET=apnacare_cron_secret_replace_with_secure_random_hex

# Reporting timezone for period calculations (defaults to Asia/Kolkata)
REPORT_TIMEZONE=Asia/Kolkata

# Optional: Server-side URL to Google Apps Script for reading data and persistent idempotency logs
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx6gwpPkEgsO9y0lksDo2MS4LFXna4dnv20XkC4_KJd3voXqxTCyBuwPg4g_BM896YV/exec

