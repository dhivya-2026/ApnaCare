{
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "30 3 1 * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/_lib/**"
    }
  }
}
